# Secrets — Stencil CLI access token, never commit this
secrets.stencil.json

# Dependencies (regenerate with `npm install`)
node_modules/

# Build output (regenerate with `npm run build` / stencil bundle)
assets/dist/

# Original purchased theme package (large binary, not source-controlled, licensed vendor asset)
*.zip

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp

# Env files, in case any get added later
.env
.env.*
.env.local

# Stencil CLI local cache / parsed template & SCSS cache
.stencil/
parsed/

# Local Claude Code settings (machine-specific, not for sharing)
.claude/settings.local.json
